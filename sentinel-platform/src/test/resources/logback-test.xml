<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Raise to DEBUG when containers fail to start: Testcontainers reports only "could not find a
       valid Docker environment" at ERROR and logs the actual reason, including the Docker API
       response, at DEBUG. -->
  <logger name="org.testcontainers" level="INFO"/>
  <logger name="com.github.dockerjava" level="WARN"/>
  <logger name="org.apache.kafka" level="WARN"/>
  <logger name="com.sentinel" level="DEBUG"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
