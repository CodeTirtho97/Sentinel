{
  "uid": "sentinel-fleet-slo",
  "title": "Sentinel — Fleet SLO",
  "tags": [
    "sentinel",
    "slo"
  ],
  "links": [
    {
      "title": "Demo console",
      "tooltip": "Back to the Sentinel demo page",
      "type": "link",
      "icon": "external link",
      "url": "http://localhost:3000",
      "targetBlank": false,
      "asDropdown": false,
      "keepTime": false,
      "includeVars": false,
      "tags": []
    },
    {
      "title": "Other dashboards",
      "tooltip": "Back to the Sentinel demo page",
      "type": "dashboards",
      "icon": "dashboard",
      "url": "",
      "targetBlank": false,
      "asDropdown": true,
      "keepTime": false,
      "includeVars": false,
      "tags": [
        "sentinel"
      ]
    }
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Incidents opened",
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "sentinel-prometheus"
        },
        "expr": "increase(sentinel_incidents_opened_total[2m]) > 0",
        "step": "60s",
        "titleFormat": "Incident opened",
        "textFormat": "severity {{severity}}",
        "tagKeys": "severity",
        "useValueForTime": false,
        "target": {
          "refId": "Anno",
          "expr": "increase(sentinel_incidents_opened_total[2m]) > 0",
          "interval": "",
          "legendFormat": ""
        }
      },
      {
        "name": "Sentinel restarted",
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "datasource": {
          "type": "prometheus",
          "uid": "sentinel-prometheus"
        },
        "expr": "(time() - process_start_time_seconds{job=\"sentinel\"}) < 90",
        "step": "60s",
        "titleFormat": "Sentinel restarted",
        "textFormat": "process start time moved — the kill-and-restart beat",
        "useValueForTime": false,
        "target": {
          "refId": "Anno",
          "expr": "(time() - process_start_time_seconds{job=\"sentinel\"}) < 90",
          "interval": "",
          "legendFormat": ""
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "objective",
        "label": "Objective",
        "type": "custom",
        "query": "0.999,0.99,0.95",
        "current": {
          "text": "0.999",
          "value": "0.999"
        },
        "options": [
          {
            "text": "0.999",
            "value": "0.999",
            "selected": true
          },
          {
            "text": "0.99",
            "value": "0.99",
            "selected": false
          },
          {
            "text": "0.95",
            "value": "0.95",
            "selected": false
          }
        ]
      },
      {
        "name": "long_window",
        "label": "Long window",
        "type": "custom",
        "query": "1m,2m,5m,15m,30m,1h,6h,3d",
        "current": {
          "text": "2m",
          "value": "2m"
        },
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "2m",
            "value": "2m",
            "selected": true
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "3d",
            "value": "3d",
            "selected": false
          }
        ]
      },
      {
        "name": "short_window",
        "label": "Short window",
        "type": "custom",
        "query": "1m,2m,5m,15m,30m,1h,6h",
        "current": {
          "text": "1m",
          "value": "1m"
        },
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": true
          },
          {
            "text": "2m",
            "value": "2m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Burn rate",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Burn rate — long window ($long_window)",
      "description": "error ratio divided by the error budget. 14.4 = CRITICAL, 6 = HIGH, 1 = MEDIUM.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prometheus"
          },
          "expr": "slo:error_ratio:$long_window / (1 - $objective)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Burn rate — short window ($short_window)",
      "description": "Both windows must exceed the threshold before a breach fires.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prometheus"
          },
          "expr": "slo:error_ratio:$short_window / (1 - $objective)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Error budget",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "collapsed": false
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Error budget remaining (30d)",
      "description": "1 - errors / (total * errorBudget), clamped to [0,1]. Needs 30 days of history to be meaningful.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prometheus"
          },
          "expr": "clamp_min(1 - (slo:errors:30d / (slo:total:30d * (1 - $objective))), 0)",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "#EAB839",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error ratio ($short_window)",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prometheus"
          },
          "expr": "slo:error_ratio:$short_window",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Traffic",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request rate",
      "description": "If this is flat at zero, rate() has no data and nothing else on this dashboard means anything.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prometheus"
          },
          "expr": "sum by (service) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Fraction slower than 500ms ($short_window)",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prometheus"
          },
          "expr": "slo:latency_ratio:$short_window{le=\"0.5\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
